import java.util.Arrays;
import java.util.Scanner;

public class TestCaseStringSort {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int testCaseNumber = 1;

        while (true) {
            System.out.println("--- Test Case #" + testCaseNumber + " ---");
            System.out.print("Enter the number of words (or enter 0 to exit): ");
            
            int size = scanner.nextInt();
            scanner.nextLine(); // Consume leftover newline character

            // Condition to break the loop and end the program
            if (size <= 0) {
                System.out.println("Exiting program. Goodbye!");
                break;
            }

            // Dynamically allocate array for this specific test case
            String[] words = new String[size];

            System.out.println("Enter your " + size + " words:");
            for (int i = 0; i < size; i++) {
                System.out.print("Word #" + (i + 1) + ": ");
                words[i] = scanner.nextLine();
            }

            // Print original input
            System.out.println("\nOriginal input: " + Arrays.toString(words));

            // Sort the array (Case-Insensitive)
            Arrays.sort(words, String.CASE_INSENSITIVE_ORDER);

            // Print sorted output
            System.out.println("Sorted output:  " + Arrays.toString(words));
            System.out.println("---------------------------\n");

            // Increment test case counter for the next loop
            testCaseNumber++;
        }

        scanner.close();
    }
}
